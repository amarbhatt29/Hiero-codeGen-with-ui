<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Global Header"
    sling:resourceType="cq/gui/components/authoring/dialog"
    helpPath="/content/help/en/cq/current/wcm/default_components.html"
    mode="edit">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs">
                <items jcr:primaryType="nt:unstructured">
                    <branding
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        granite:rel="granite:tab"
                        granite:title="Branding">
                        <items jcr:primaryType="nt:unstructured">
                            <logoImage
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                fieldLabel="Logo / Brand Asset"
                                fieldDescription="Select the logo or brand asset for the header"
                                name="./logoPath"
                                allowBlank="{Boolean}false"/>
                            <logoAlt
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Logo Alt Text"
                                fieldDescription="Accessibility: Alternative text for the logo image"
                                name="./logoAlt"
                                required="{Boolean}true"/>
                            <logoLink
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/authoring/dialog/pathfield"
                                fieldLabel="Logo Link Destination"
                                fieldDescription="Page or URL the logo should link to (typically homepage)"
                                name="./logoLink"/>
                        </items>
                    </branding>
                    <navigation
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        granite:rel="granite:tab"
                        granite:title="Navigation">
                        <items jcr:primaryType="nt:unstructured">
                            <navReference
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/authoring/dialog/pathfield"
                                fieldLabel="Navigation Component Reference"
                                fieldDescription="Path to the navigation component or configuration to display"
                                name="./navigationPath"
                                required="{Boolean}true"/>
                            <navLabel
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Navigation ARIA Label"
                                fieldDescription="Accessibility: Label for main navigation area"
                                name="./navigationLabel"
                                value="Main Navigation"/>
                        </items>
                    </navigation>
                    <search
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        granite:rel="granite:tab"
                        granite:title="Search">
                        <items jcr:primaryType="nt:unstructured">
                            <enableSearch
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                fieldLabel="Enable Search"
                                name="./enableSearch"
                                value="true"
                                checked="{Boolean}true"/>
                            <searchAction
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/authoring/dialog/pathfield"
                                fieldLabel="Search Results Page"
                                fieldDescription="Page to submit search queries to"
                                name="./searchAction"/>
                            <searchLabel
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Search Button ARIA Label"
                                fieldDescription="Accessibility: Label for search icon/button"
                                name="./searchLabel"
                                value="Search"/>
                        </items>
                    </search>
                    <utilities
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        granite:rel="granite:tab"
                        granite:title="Utilities">
                        <items jcr:primaryType="nt:unstructured">
                            <languageLink
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/authoring/dialog/pathfield"
                                fieldLabel="Language Selector Link"
                                fieldDescription="Link to language/locale selection page"
                                name="./languageLink"/>
                            <languageLabel
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Language Button ARIA Label"
                                name="./languageLabel"
                                value="Select Language"/>
                            <helpLink
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/authoring/dialog/pathfield"
                                fieldLabel="Help / Support Link"
                                name="./helpLink"/>
                            <helpLabel
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Help Button ARIA Label"
                                name="./helpLabel"
                                value="Help and Support"/>
                            <loginLink
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/authoring/dialog/pathfield"
                                fieldLabel="Login Link"
                                fieldDescription="Link to login page or authentication service"
                                name="./loginLink"
                                required="{Boolean}true"/>
                            <loginLabel
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Login Button Label"
                                name="./loginLabel"
                                value="Login"/>
                        </items>
                    </utilities>
                    <behavior
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        granite:rel="granite:tab"
                        granite:title="Behavior">
                        <items jcr:primaryType="nt:unstructured">
                            <enableSticky
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                fieldLabel="Enable Sticky / Fixed Header"
                                fieldDescription="Keep header visible when scrolling (use only where approved by design)"
                                name="./enableSticky"
                                value="true"/>
                            <stickyBehavior
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Sticky Behavior"
                                name="./stickyBehavior">
                                <items jcr:primaryType="nt:unstructured">
                                    <sticky
                                        jcr:primaryType="nt:unstructured"
                                        value="sticky"
                                        text="Sticky (scrolls with content)"/>
                                    <fixed
                                        jcr:primaryType="nt:unstructured"
                                        value="fixed"
                                        text="Fixed (stays in place)"/>
                                </items>
                            </stickyBehavior>
                        </items>
                    </behavior>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
